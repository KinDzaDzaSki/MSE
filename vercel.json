{
  "crons": [
    {
      "path": "/api/cron/movers",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron/movers",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/movers",
      "schedule": "0 17 * * 1-5"
    },
    {
      "path": "/api/cron/deep-history",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/backfill",
      "schedule": "30 14 * * 1-5"
    },
    {
      "path": "/api/cron/backfill",
      "schedule": "30 16 * * 1-5"
    },
    {
      "path": "/api/cron/index-history",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
