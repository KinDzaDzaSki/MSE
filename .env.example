# Copy this file to `.env` and fill in your values (do NOT commit .env).
# On Render AND Railway, DATABASE_URL is injected automatically when you
# attach a PostgreSQL plugin/database — you usually don't need to set it manually.

# PostgreSQL connection string (Railway/Postgres add-on provides this).
# Local example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mse

# Optional: server port (hosts set this automatically).
# PORT=3000

# Optional: MSE scrape cadence during the trading session, in ms.
# Default 300000 (5 min). The old 60s tick is *not* recommended — MSE is a
# thin market and trades land minutes apart; an EOD capture poll after close
# guarantees the final numbers regardless of this setting.
# POLL_INTERVAL_MS=300000

# Optional: shared secret guarding expensive endpoints
# (/api/backfill/*, /api/refresh, /api/logs). Unset = open (local dev).
# Set it in production and pass ?token= or the x-admin-token header.
# ADMIN_TOKEN=change-me-to-something-long
